{
  "name": "GYANIFY Android",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "remoteEnv": {
    "FLUTTER_ROOT": "${containerEnv:HOME}/.local/share/gyanify/flutter",
    "ANDROID_HOME": "${containerEnv:HOME}/.local/share/gyanify/android-sdk",
    "ANDROID_SDK_ROOT": "${containerEnv:HOME}/.local/share/gyanify/android-sdk",
    "PATH": "${containerEnv:HOME}/.local/share/gyanify/flutter/bin:${containerEnv:HOME}/.local/share/gyanify/android-sdk/cmdline-tools/latest/bin:${containerEnv:HOME}/.local/share/gyanify/android-sdk/platform-tools:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ]
    }
  }
}